<Layouts.flash_group flash={@flash} />

<%!-- Navigation Bar --%>
<nav class="fixed top-0 left-0 right-0 z-50 bg-base-100/80 backdrop-blur-md border-b border-base-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <%!-- Logo + Name --%>
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center">
          <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-primary-content" aria-hidden="true">
            <path d="M12 3L2 8l10 5 10-5-10-5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M2 16l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="font-bold text-base-content text-lg tracking-tight">Canaan</span>
        <span class="badge badge-primary badge-sm hidden sm:inline-flex">CBC</span>
      </div>

      <%!-- Nav Links --%>
      <div class="hidden md:flex items-center gap-6 text-sm text-base-content/70">
        <a href="#features" class="hover:text-base-content transition-colors">Features</a>
        <a href="#roles" class="hover:text-base-content transition-colors">Who It's For</a>
        <a href="#about" class="hover:text-base-content transition-colors">About</a>
      </div>

      <%!-- CTA Buttons --%>
      <div class="flex items-center gap-3">
        <a href="/login" class="btn btn-ghost btn-sm hidden sm:inline-flex">Log in</a>
        <a href="/register" class="btn btn-primary btn-sm">SignUp</a>
      </div>
    </div>
  </div>
</nav>

<%!-- Hero Section --%>
<section class="relative min-h-screen flex items-center overflow-hidden pt-16">
  <%!-- Background Gradient --%>
  <div class= "flex justify-center items-center max-h-screen bg-gray-100">
  <img
  src= {~p"/images/home-banner.jpg"}
  alt="Welcome to modern canaan"
  class= "w-full max-w-4xl h-auto rounded-lg shadow-lg"
  />
  </div>
  <div class="absolute top-0 right-0 w-1/2 h-full z-0 hidden lg:block">
    <div class="absolute inset-0 bg-gradient-to-l from-primary/10 via-primary/5 to-transparent"></div>
    <svg viewBox="0 0 600 800" class="w-full h-full opacity-30" aria-hidden="true">
      <defs>
        <radialGradient id="hero-grad" cx="60%" cy="40%" r="60%">
          <stop offset="0%" stop-color="#2563EB" stop-opacity="0.3"/>
          <stop offset="100%" stop-color="#2563EB" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="600" height="800" fill="url(#hero-grad)"/>
      <circle cx="400" cy="300" r="200" fill="#3B82F6" fill-opacity="0.08"/>
      <circle cx="500" cy="500" r="150" fill="#60A5FA" fill-opacity="0.06"/>
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="max-w-3xl">
      <%!-- Badge --%>
      <div class="inline-flex items-center gap-2 bg-primary/10 text-primary rounded-full px-4 py-1.5 text-sm font-medium mb-8">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        CBC-Aligned School Management
      </div>

      <%!-- Headline --%>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-base-content leading-tight tracking-tight mb-6">
        Modern Canaan  school
        <span class="text-primary block">P.C.E.A</span>
      </h1>

      <%!-- Subheadline --%>
      <p class="text-lg sm:text-xl text-base-content/60 leading-relaxed max-w-2xl mb-10">
        Canaan is a CBC-aligned school management system built for Kenyan schools.
        Streamline enrollment, attendance, grades, and communication — all in one place.
      </p>

      <%!-- CTAs --%>
      <div class="flex flex-col sm:flex-row gap-4 mb-16">
        <a href="/register" class="btn btn-primary btn-lg gap-2">
          <svg viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
          </svg>
          Sign Up Today
        </a>
        <a href="#features" class="btn btn-outline btn-lg gap-2">
          <svg viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
          </svg>
          See How It Works
        </a>
      </div>

      <%!-- Quick Stats --%>
      <div class="flex flex-wrap gap-8">
        <div>
          <p class="text-2xl font-bold text-base-content">CBC</p>
          <p class="text-sm text-base-content/50">Curriculum Aligned</p>
        </div>
        <div class="w-px bg-base-300"></div>
        <div>
          <p class="text-2xl font-bold text-base-content">100%</p>
          <p class="text-sm text-base-content/50">Open Source</p>
        </div>
        <div class="w-px bg-base-300"></div>
        <div>
          <p class="text-2xl font-bold text-base-content">Built in 🇰🇪</p>
          <p class="text-sm text-base-content/50">For Kenyan Schools</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- Features Section --%>
<section id="features" class="py-24 bg-base-200/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-primary font-semibold text-sm uppercase tracking-widest mb-3">What's Included</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-base-content mb-4">Everything a school needs</h2>
      <p class="text-base-content/60 max-w-xl mx-auto">From enrolment to end-of-term reports, Canaan covers the full school cycle.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

      <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
            <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-primary" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Student Enrollment</h3>
          <p class="text-base-content/60 text-sm">Register students, manage class assignments, and maintain complete learner records.</p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center mb-4">
            <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-success" aria-hidden="true">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Attendance Tracking</h3>
          <p class="text-base-content/60 text-sm">Daily attendance records per class, with automatic absence alerts for parents.</p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center mb-4">
            <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-warning" aria-hidden="true">
              <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">CBC Grades & Reports</h3>
          <p class="text-base-content/60 text-sm">Enter formative and summative scores. Generate CBC-format report cards per term.</p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-info/10 flex items-center justify-center mb-4">
            <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-info" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 10h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Fee Management</h3>
          <p class="text-base-content/60 text-sm">Track fee payments, generate receipts, and send balance reminders to parents.</p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center mb-4">
            <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-secondary" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Timetable & Scheduling</h3>
          <p class="text-base-content/60 text-sm">Create and manage weekly class timetables for teachers and learners.</p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-error/10 flex items-center justify-center mb-4">
            <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-error" aria-hidden="true">
              <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Notices & Communication</h3>
          <p class="text-base-content/60 text-sm">Broadcast school announcements to staff, parents, and learners instantly.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<%!-- Roles Section --%>
<section id="roles" class="py-24 bg-base-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-primary font-semibold text-sm uppercase tracking-widest mb-3">Who It's For</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-base-content mb-4">One system, every role</h2>
      <p class="text-base-content/60 max-w-xl mx-auto">Canaan gives every person in your school the right tools for their role.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center p-8 rounded-2xl border border-base-200 hover:border-primary/30 transition-colors">
        <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mx-auto mb-6">
          <svg viewBox="0 0 24 24" fill="none" class="w-8 h-8 text-primary" aria-hidden="true">
            <path d="M12 14l9-5-9-5-9 5 9 5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-bold text-lg text-base-content mb-3">Administrators</h3>
        <p class="text-base-content/60 text-sm leading-relaxed">Full school oversight — enrolment, staff, fees, reports, and system settings in a unified dashboard.</p>
      </div>

      <div class="text-center p-8 rounded-2xl border border-base-200 hover:border-primary/30 transition-colors">
        <div class="w-16 h-16 rounded-2xl bg-success/10 flex items-center justify-center mx-auto mb-6">
          <svg viewBox="0 0 24 24" fill="none" class="w-8 h-8 text-success" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/>
            <path d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-bold text-lg text-base-content mb-3">Teachers</h3>
        <p class="text-base-content/60 text-sm leading-relaxed">Mark attendance, enter CBC scores, share learning materials, and communicate with parents — all in one place.</p>
      </div>

      <div class="text-center p-8 rounded-2xl border border-base-200 hover:border-primary/30 transition-colors">
        <div class="w-16 h-16 rounded-2xl bg-warning/10 flex items-center justify-center mx-auto mb-6">
          <svg viewBox="0 0 24 24" fill="none" class="w-8 h-8 text-warning" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-bold text-lg text-base-content mb-3">Parents</h3>
        <p class="text-base-content/60 text-sm leading-relaxed">Track your child's attendance, view report cards, pay fees, and receive school notices directly.</p>
      </div>
    </div>
  </div>
</section>

<%!-- About / Open Source CTA 
<section id="about" class="py-24 bg-primary">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-primary-content/70 font-semibold text-sm uppercase tracking-widest mb-4">Open Source</p>
    <h2 class="text-3xl sm:text-4xl font-bold text-primary-content mb-6">
      Built for Kenya. Free for all.
    </h2>
    <p class="text-primary-content/70 text-lg leading-relaxed max-w-2xl mx-auto mb-10">
      Canaan is an open-source CBC school management system. No licensing fees.
      Self-host it, contribute to it, or deploy it in minutes. Built with Elixir and Phoenix.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/register" class="btn btn-white btn-lg gap-2">
        Create Your Account
      </a>
      <a href="https://github.com" target="_blank" rel="noopener" class="btn btn-outline btn-lg border-primary-content/40 text-primary-content hover:bg-primary-content/10 gap-2">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
        </svg>
        View on GitHub
      </a>
    </div>
  </div>
</section>--%>

<%!-- Footer --%>
<footer class="bg-base-200 border-t border-base-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-md bg-primary flex items-center justify-center">
          <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4 text-primary-content" aria-hidden="true">
            <path d="M12 3L2 8l10 5 10-5-10-5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M2 16l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="font-semibold text-base-content">Canaan School System</span>
      </div>
      <p class="text-sm text-base-content/50">
        © 2025 Canaan · Open Source 
      </p>
      <div class="flex gap-6 text-sm text-base-content/50">
        <a href="#" class="hover:text-base-content transition-colors">Privacy</a>
        <a href="#" class="hover:text-base-content transition-colors">Terms</a>
        <a href="#" class="hover:text-base-content transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
