<main class="min-h-screen bg-gray-100 py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Header -->
    <section class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 bg-blue-400 p-2 rounded-lg">
          Roles & Permissions
        </h1>

        <p class="mt-1 text-sm text-gray-600">
          Manage system roles and their assigned permissions.
        </p>
      </div>

      <.link
        href={~p"/admin/roles/new"}
        class="inline-flex items-center justify-center rounded-lg bg-primary-700 px-4 py-2 text-sm font-medium text-white hover:bg-primary-800"
      >
        New Role
      </.link>
    </section>

    <!-- Statistics -->
    <section class="grid gap-4 sm:grid-cols-2">

      <div class="rounded-xl border bg-white p-6 shadow-sm">
        <p class="text-sm text-gray-500">
          Total Roles
        </p>

        <p class="mt-2 text-3xl font-bold text-gray-900">
          {@role_count}
        </p>
      </div>

      <div class="rounded-xl border bg-white p-6 shadow-sm">
        <p class="text-sm text-gray-500">
          Total Permissions
        </p>

        <p class="mt-2 text-3xl font-bold text-gray-900">
          {@permission_count}
        </p>
      </div>

    </section>

    <!-- Roles Table -->
    <section class="overflow-hidden rounded-xl border bg-white shadow-sm">

      <div class="border-b px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900">
          Roles
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">

          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                Role
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                Type
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                Permissions
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                Status
              </th>

              <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">
                Actions
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100 bg-white">

            <tr
              :for={role <- @roles}
              class="hover:bg-gray-50"
            >
              <!-- Role Name -->
              <td class="px-6 py-4">
                <div class="font-medium text-gray-900">
                  {role.name}
                </div>

                <div class="text-xs text-gray-500">
                  {role.slug}
                </div>
              </td>

              <!-- Type -->
              <td class="px-6 py-4">
                <span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">
                  {role.type}
                </span>
              </td>

              <!-- Permissions -->
              <td class="px-6 py-4">
                <%= if Enum.empty?(role.permissions) do %>
                  <span class="text-sm text-gray-400">
                    No permissions assigned
                  </span>
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <span
                      :for={permission <- role.permissions}
                      class="inline-flex rounded-full bg-gray-100 px-2 py-1 text-xs text-gray-700"
                    >
                      {permission.name}
                    </span>
                  </div>
                <% end %>
              </td>

              <!-- Status -->
              <td class="px-6 py-4">
                <span
                  class={[
                    "inline-flex rounded-full px-3 py-1 text-xs font-medium",
                    role.status == "active" &&
                      "bg-green-100 text-green-700",
                    role.status != "active" &&
                      "bg-gray-100 text-gray-700"
                  ]}
                >
                  {role.status}
                </span>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4 text-right">
                <.link
                  href={~p"/admin/roles/#{role.id}/edit"}
                  class="font-medium text-primary-700 hover:text-primary-800 hover:underline"
                >
                  Edit
                </.link>
              </td>
            </tr>

          </tbody>

        </table>
      </div>

    </section>

  </div>
</main>